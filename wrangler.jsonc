{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sp-web",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "none",
    "run_worker_first": ["/", "/api/*"]
  },
  "vars": {
    "OWNER_EMAIL": "spinanspiritus@gmail.com",
    "FROM_EMAIL": "Spina & Spiritus <orders@spinanspiritus.com>"
  }
}
